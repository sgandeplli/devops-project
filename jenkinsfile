pipeline {
    agent any
    
    environment {
        GOOGLE_APPLICATION_CREDENTIALS = credentials('gcp-sa')
    }

    stages {
        stage('connecting git') {
            steps {
                git url: "https://github.com/sgandeplli/naruto.git", branch: "main"
            }
        }
        
        stage('Terraform Init & Apply') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    dir('specific-folder') {
                        // Run Terraform commands in the specified folder
                        sh 'terraform init -chdir=/PHANI/bucket'
                        sh 'terraform plan -chdir=/PHANI/bucket'
                        sh 'terraform apply -auto-approve -chdir=/PHANI/bucket'
                    }
                }
            }
        }
    }
}

pipeline {
    agent any
    
    environment {
        GOOGLE_APPLICATION_CREDENTIALS = credentials('gcp-sa')
    }

    stages {
        stage('connecting git') {
            steps {
                git url: "https://github.com/sgandeplli/devops-project.git", branch: "feature/"
            }
        }
        
        stage('Terraform Init & Apply') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    dir('specific-folder') {
                        // Run Terraform commands in the specified folder
                        sh 'terraform init'
                        sh 'terraform plan'
                        sh 'terraform apply -auto-approve'
                    }
                }
            }
        }
    }
}
